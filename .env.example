# GPTProto API Configuration
GPTPROTO_API_KEY=sk-your-api-key-here
GPTPROTO_BASE_URL=https://gptproto.com

# LLM Configuration
LLM_MODEL=claude-sonnet-4-5-20250929
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# Image Generation Configuration
IMAGE_MODEL=flux-kontext-pro
IMAGE_DEFAULT_PROMPT_PREFIX="photorealistic portrait, high quality, detailed"

# Voice Configuration
VOICE_MODEL=speech-2.5-hd-preview-voice-clone
VOICE_CUSTOM_ID=amir-voice-001
VOICE_ACCURACY=0.7
VOICE_NOISE_REDUCTION=true
VOICE_VOLUME_NORMALIZATION=true

# Music Configuration
MUSIC_MODEL=chirp-v3-5
MUSIC_DEFAULT_DURATION=30
MUSIC_INSTRUMENTAL=true

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/amir_ai
DATABASE_ECHO=false

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Storage Configuration
S3_BUCKET=amir-ai-assets
S3_REGION=us-east-1
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
CDN_URL=https://cdn.example.com

# Application Configuration
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# Security
SECRET_KEY=your-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Monitoring
SENTRY_DSN=
